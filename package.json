{
  "name": "sukope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ブラウザで動くリアルタイム スペクトログラム",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
